---
import Base from "../../../../layouts/Base.astro";
import BrandGallery from "../../../../components/BrandGallery.astro";
import CodeBlock from "../../../../components/CodeBlock.astro";
import Preview from "../../../../components/Preview.astro";
import { brandsFor, kitCategories, previewWidth, kitList, kitTemplates, kitUrl, recreationLabel, sitePath, templateUrl, type TemplateInfo } from "../../../../lib/kits";

export function getStaticPaths() {
  return kitTemplates.map((t) => ({ params: { kit: t.kit, root: t.folder, category: t.category }, props: { t } }));
}
const { t } = Astro.props as { t: TemplateInfo };
const kit = kitList.find((k) => k.id === t.kit)!;
const category = kitCategories[t.category];
const list = brandsFor(t);
const siblings = kitTemplates.filter((o) => o.kit === t.kit && o.key !== t.key);
const others = kitTemplates.filter((o) => o.category === t.category && o.kit !== t.kit);
const views = t.root === "Document" ? (["desktop", "pdf"] as const) : t.root === "Canvas" ? (["image"] as const) : t.root === "Email" ? (["desktop", "phone", "text"] as const) : (["desktop", "phone"] as const);
const width = previewWidth(t);
const file = `${t.category}.tsx`;
// The views above the preview: an email or page at desktop width and on a phone (an email's plain text too), a
// document as its page and as its PDF, an image in each of its formats.
const modes =
  t.root === "Canvas"
    ? t.formats.map((f) => ({ id: f, label: f.charAt(0).toUpperCase() + f.slice(1) }))
    : t.root === "Document"
      ? [{ id: "desktop", label: "Page" }, { id: "pdf", label: "PDF" }]
      : [{ id: "desktop", label: "Desktop" }, { id: "phone", label: "Phone" }, ...(t.root === "Email" ? [{ id: "text", label: "Plain text" }] : [])];
const shownFormats = t.formats.length ? (t.root === "Canvas" ? t.formats : [t.formats[0]]) : ["default"];
const codeTabs = [
  { id: "design", label: "Design", file },
  { id: "brand", label: "Brand", file: "brand.ts" },
];
const starter = `kit-${t.kit}-${t.folder}-${t.category}`;
---
<Base title={`${t.label}: ${kit.name}`} description={`${t.description}. A ${t.output.toLowerCase()} template in the ${kit.name} kit, previewed in each sample brand, with one file to copy.`}>
  <section class="t-hero">
    <div class="wrap">
      <a class="back" href="/templates">← Templates</a>
      <div class="t-head">
        <div>
          <p class="eyebrow">{category.group} · {category.label}</p>
          <h1 class="h-page" style="margin:0 0 10px">{t.label}</h1>
          <p class="lede">{t.description}.</p>
          <p class="meta">In the <a href={kitUrl(t.kit)}>{kit.name}</a> kit · by {t.author} · <a href={`https://github.com/hyper-elements/hyper-elements/blob/main/${t.file}`}>source on GitHub</a></p>
          {t.recreates && (
            <div class="recreation">
              <p class="rec-label">{recreationLabel(t)}</p>
              <p class="rec-note">
                {t.recreates.company}'s name and logo belong to {t.recreates.company}. This rebuild shows how Hyper Elements draws a real email; the project isn't affiliated with {t.recreates.company}, and the rebuild will be removed on request (<a href="https://github.com/hyper-elements/hyper-elements/issues/new?template=recreation-removal.yml">ask here</a>).
                {t.recreates.original.startsWith("https://hyperelements.dev/") ? null : <> See <a href={t.recreates.original}>the original</a>.</>}
              </p>
              {t.recreates.original.startsWith("https://hyperelements.dev/") && <figure class="original"><img src={sitePath(t.recreates.original)} alt={`The original: ${t.recreates.what}`} loading="lazy" /><figcaption>The original</figcaption></figure>}
            </div>
          )}
        </div>
        <span class="chip">{t.output}</span>
      </div>
      <div class="t-switch">
        <p class="t-switch-label">In every sample brand{t.recreates ? ", and the original" : ""}. Pick one to see it below, and to copy its file.</p>
        <BrandGallery t={t} />
      </div>
    </div>
  </section>
  <div class="wrap">
    <div class="stage panel" data-stage data-show="preview">
      <div class="stage-bar">
        <div class="seg" role="tablist" aria-label="View">
          {modes.map((m, i) => <button type="button" role="tab" aria-selected={i === 0 ? "true" : "false"} data-mode-pick={m.id}>{m.label}</button>)}
        </div>
        <button type="button" class="code-toggle" aria-pressed="false" data-code-toggle><span aria-hidden="true">&lt;/&gt;</span> Code</button>
      </div>
      <div class="stage-preview">
        {list.map((b, i) => (
          <div data-brand={b.id} hidden={i !== 0}>
            {shownFormats.map((format, j) => {
              const ex = t.byBrand[b.id]?.views[format];
              return ex && (
                <div data-format={format} hidden={t.root === "Canvas" && j !== 0}>
                  <Preview example={ex} views={[...views]} width={width} height={t.root === "Canvas" ? 640 : 820} />
                </div>
              );
            })}
          </div>
        ))}
      </div>
      <div class="stage-code" hidden>
        <div class="code-bar">
          <div class="seg" role="tablist" aria-label="Code">
            {codeTabs.map((c, i) => <button type="button" role="tab" aria-selected={i === 0 ? "true" : "false"} data-code-pick={c.id}>{c.label} <span class="file">{c.file}</span></button>)}
          </div>
          <div class="code-actions">
            <a class="btn-link" href={`/playground#starter=${starter}`}>Open in the playground</a>
            {list.map((b, i) => <button class="btn-link" type="button" data-brand={b.id} hidden={i !== 0} data-copy={t.byBrand[b.id]?.single ?? ""}>Copy all as one file</button>)}
          </div>
        </div>
        <div data-code-pane="design">
          <CodeBlock code={t.code} />
          <p class="note">The design: plain JSX of Elements' own elements, with real words in it. Every color, font and size comes from your brand, in <code>brand.ts</code>.</p>
        </div>
        <div data-code-pane="brand" hidden>
          {list.map((b, i) => <div data-brand={b.id} hidden={i !== 0}><CodeBlock code={t.byBrand[b.id]?.brandFile ?? ""} lang="ts" /></div>)}
          <p class="note">The brand it's drawn in: its colors, fonts, logo and links. Replace it with your own.</p>
        </div>
      </div>
    </div>
  </div>
  <section class="wrap facts">
    <div>
      <h2 class="cg-title">When to use it</h2>
      <p class="when">{category.useWhen}. Not for: {category.avoidWhen.charAt(0).toLowerCase() + category.avoidWhen.slice(1)}.</p>
      <h2 class="cg-title">What it's checked for</h2>
      <ul class="rules">
        <li>Readable text in every sample brand: 4.5:1 contrast, and large enough to read.</li>
        <li>Every color and font from the brand's theme, so your brand.ts restyles all of it.</li>
        <li>Nothing wider than its {t.root === "Canvas" ? "canvas" : t.root === "Document" ? "page" : "layout"}{t.root === "Canvas" ? ", and every line of text fitting its box" : ""}.</li>
        {t.root === "Email" && <li>Nothing the major email clients drop, and links and images that say what they are.</li>}
        {t.root === "Document" && <li>Every font and image drawn in the PDF.</li>}
      </ul>
    </div>
    <div>
      <h2 class="cg-title">Fill it in again and again</h2>
      <p class="when">To fill this design with new content each time (a CMS, a batch, an agent writing only the words), turn it into a template with typed fields. Give each part that changes an <code>id</code> (<code>&lt;Heading id="headline"&gt;</code>), then:</p>
      <CodeBlock code={`npx hyper-elements template extract ${t.category}.tsx --id acme.${t.category.replace(/(^|-)([a-z0-9])/g, (_, __, c) => c.toUpperCase())} --field headline -o templates/${t.category}.tsx`} lang="bash" />
    </div>
  </section>
  {(siblings.length > 0 || others.length > 0) && (
    <section class="wrap more">
      {siblings.length > 0 && <><h2 class="cg-title">More in {kit.name}</h2><div class="more-list">{siblings.map((o) => <a class="chip" href={templateUrl(o)}>{o.label}</a>)}</div></>}
      {others.length > 0 && <><h2 class="cg-title">Other {category.label.toLowerCase()} templates</h2><div class="more-list">{others.map((o) => <a class="chip" href={templateUrl(o)}>{kitList.find((k) => k.id === o.kit)?.name}</a>)}</div></>}
    </section>
  )}
</Base>

<script>
  // The stage shows one thing: the preview in the view picked, or the code. The views drive each brand's preview
  // (its own tabs are hidden); an image's are its formats instead.
  const stage = document.querySelector<HTMLElement>("[data-stage]");
  if (stage) {
    const preview = stage.querySelector<HTMLElement>(".stage-preview")!;
    const code = stage.querySelector<HTMLElement>(".stage-code")!;
    const toggle = stage.querySelector<HTMLButtonElement>("[data-code-toggle]")!;
    const modes = [...stage.querySelectorAll<HTMLButtonElement>("[data-mode-pick]")];
    const formats = [...stage.querySelectorAll<HTMLElement>("[data-format]")];
    const byFormat = formats.some((f) => modes.some((m) => m.dataset.modePick === f.dataset.format));
    const show = (what: "preview" | "code") => {
      stage.dataset.show = what;
      preview.hidden = what !== "preview";
      code.hidden = what !== "code";
      toggle.setAttribute("aria-pressed", String(what === "code"));
      window.dispatchEvent(new Event("resize"));
    };
    modes.forEach((m) =>
      m.addEventListener("click", () => {
        const id = m.dataset.modePick!;
        modes.forEach((x) => x.setAttribute("aria-selected", String(x === m)));
        if (byFormat) formats.forEach((f) => (f.hidden = f.dataset.format !== id));
        else stage.querySelectorAll<HTMLButtonElement>(`.preview [role="tab"][data-view="${id}"]`).forEach((tab) => tab.click());
        show("preview");
      }),
    );
    toggle.addEventListener("click", () => show(stage.dataset.show === "code" ? "preview" : "code"));
    const tabs = [...stage.querySelectorAll<HTMLButtonElement>("[data-code-pick]")];
    tabs.forEach((tab) =>
      tab.addEventListener("click", () => {
        tabs.forEach((x) => x.setAttribute("aria-selected", String(x === tab)));
        stage.querySelectorAll<HTMLElement>("[data-code-pane]").forEach((pane) => (pane.hidden = pane.dataset.codePane !== tab.dataset.codePick));
      }),
    );
  }
</script>

<style>
  .t-hero { padding: 48px 0 24px; }
  .back { color: var(--text-3); text-decoration: none; font-size: 14px; display: inline-block; margin-bottom: 20px; }
  .back:hover { color: var(--text); }
  .t-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; }
  .meta { color: var(--text-3); font-size: 14px; margin: 8px 0 0; }
  .meta a { color: var(--text-2); }
  .t-switch { margin-top: 28px; }
  .t-switch-label { font-size: 14px; color: var(--text-3); margin: 0 0 12px; }
  .recreation { margin-top: 16px; padding: 14px 16px; border: 1px solid var(--line-2); border-radius: var(--radius); max-width: 760px; }
  .rec-label { font: 500 13px var(--mono); margin: 0 0 6px; color: var(--text); }
  .rec-note { font-size: 13.5px; color: var(--text-3); margin: 0; }
  .rec-note a { color: var(--text-2); }
  .original { margin: 12px 0 0; }
  .original img { max-width: 100%; max-height: 420px; border: 1px solid var(--line); }
  .original figcaption { font-size: 12px; color: var(--text-3); margin-top: 4px; }
  .btn-link { background: none; border: 0; padding: 0; color: var(--text-2); font: 13px var(--sans); text-decoration: underline; cursor: pointer; }
  .btn-link[data-copied]::after { content: " ✓"; }
  .note { color: var(--text-3); font-size: 13.5px; margin: 10px 2px 0; }
  .stage { padding: 0; overflow: hidden; background: var(--bg-2, #0e0e0e); }
  .stage-bar, .code-bar { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 10px 12px; border-bottom: 1px solid var(--line); flex-wrap: wrap; }
  .seg { display: inline-flex; gap: 2px; padding: 3px; border: 1px solid var(--line-2); border-radius: 999px; }
  .seg button { padding: 5px 14px; border: 0; border-radius: 999px; background: transparent; color: var(--text-2); font: 13px var(--sans); cursor: pointer; white-space: nowrap; }
  .seg button[aria-selected="true"] { background: var(--text); color: var(--bg); }
  .seg .file { font: 11.5px var(--mono); opacity: 0.7; margin-left: 4px; }
  .code-toggle { padding: 6px 14px; border-radius: 999px; border: 1px solid var(--line-2); background: transparent; color: var(--text); font: 500 13px var(--sans); cursor: pointer; }
  .code-toggle[aria-pressed="true"] { background: var(--text); color: var(--bg); border-color: var(--text); }
  .stage[data-show="code"] .stage-bar .seg button[aria-selected="true"] { background: transparent; color: var(--text-2); }
  .stage :global(.preview .tabs) { display: none; }
  .stage :global(.preview .view-frame .scaler) { margin: 0 auto; }
  .stage-code { padding: 0 0 14px; }
  .code-bar { border-bottom: 0; padding-bottom: 0; }
  .code-actions { display: flex; gap: 16px; align-items: center; }
  [data-code-pane] { padding: 10px 12px 0; }
  [data-code-pane] :global(.code-block) { max-height: 760px; overflow: auto; margin: 0; }
  .facts { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: 32px; margin-top: 56px; }
  .cg-title { font: 500 12.5px var(--mono); text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-3); margin: 0 0 14px; }
    .rules { padding-left: 18px; color: var(--text-2); font-size: 14px; margin: 0 0 24px; }
  .rules li { margin-bottom: 6px; }
  .when { color: var(--text-2); font-size: 14px; margin: 0 0 24px; }
  .facts :global(.code-block) { margin: 0; }
  .more { margin-top: 56px; display: grid; gap: 12px; }
  .more-list { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 12px; }
  .more-list a { text-decoration: none; }
  @media (max-width: 640px) {
    .seg { max-width: 100%; overflow-x: auto; scrollbar-width: none; }
    .seg .file { display: none; }
  }
  @media (max-width: 1000px) {
    .facts { grid-template-columns: minmax(0, 1fr); }
    .t-head { flex-direction: column; align-items: flex-start; }
  }
</style>
