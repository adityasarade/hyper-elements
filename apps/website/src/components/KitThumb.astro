---
// A template's thumbnail in one brand: its email, page or print HTML drawn live, or an image's PNG. A thumbnail of a
// fixed height shows the template's top; a `full` one shows all of it, as tall as it is at the column's width (up to
// three times as tall as wide, faded at its foot past that).
import { previewHtml } from "../lib/examples";
import { brandsFor, firstView, previewWidth, type TemplateInfo } from "../lib/kits";
interface Props { t: TemplateInfo; brand?: string; height?: number; full?: boolean }
const { t, height = 300, full = false } = Astro.props;
const brand = brandsFor(t).find((b) => b.id === Astro.props.brand) ?? brandsFor(t)[0];
const width = t.root === "Page" ? 1100 : t.root === "Email" ? 640 : previewWidth(t, brand.id);
const view = firstView(t, brand.id);
const bg = brand.colors.background;
// Before a full thumbnail's frame has loaded and been measured: a page's share of its width, or an email's guess.
const guess = t.root === "Document" ? 1.32 : t.root === "Page" ? 1.2 : 1.6;
---
{view && (
  full ? (
    <div class="kthumb full" aria-hidden="true">
      {t.root === "Canvas" ? (
        <img class="kt-full-image" src={view.file} alt="" loading="lazy" />
      ) : (
        <div class="thumb view-frame" data-fit={width} data-fit-full style={`aspect-ratio:1/${guess};--frame-bg:${bg}`}>
          <div class="scaler">
            <iframe title="" tabindex="-1" srcdoc={previewHtml(view.html)} width={width} height={Math.round(width * guess)} loading="lazy"></iframe>
          </div>
        </div>
      )}
    </div>
  ) : (
    <div class="kthumb" style={`height:${height}px`} aria-hidden="true">
      {t.root === "Canvas" ? (
        <div class="kt-image" style={`background:${bg}`}>
          <img src={view.file} alt="" loading="lazy" />
        </div>
      ) : (
        <div class="thumb view-frame" data-fit={width} style={`height:${height}px;--frame-bg:${bg}`}>
          <div class="scaler">
            <iframe title="" tabindex="-1" srcdoc={previewHtml(view.html)} width={width} height={height} loading="lazy"></iframe>
          </div>
        </div>
      )}
    </div>
  )
)}
<style>
  .kthumb { pointer-events: none; border-bottom: 1px solid var(--line); overflow: hidden; }
  .kthumb.full { border-bottom: 0; }
  .kt-image { height: 100%; display: grid; place-items: center; }
  .kt-image img { max-width: 100%; max-height: 100%; object-fit: contain; }
  .kt-full-image { display: block; width: 100%; height: auto; }
  .kthumb :global(.view-frame[data-capped]) { position: relative; }
  .kthumb :global(.view-frame[data-capped])::after { content: ""; position: absolute; inset: auto 0 0; height: 72px; background: linear-gradient(transparent, var(--frame-bg)); }
</style>
