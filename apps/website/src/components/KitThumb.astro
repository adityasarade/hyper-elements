---
// A template's thumbnail in one brand: its email, page or print HTML drawn live, or an image's PNG.
import { previewHtml } from "../lib/examples";
import { brandsFor, firstView, type TemplateInfo } from "../lib/kits";
interface Props { t: TemplateInfo; brand?: string; height?: number }
const { t, height = 300 } = Astro.props;
const brand = brandsFor(t).find((b) => b.id === Astro.props.brand) ?? brandsFor(t)[0];
const width = t.root === "Page" ? 1100 : t.root === "Document" ? 820 : t.root === "Canvas" ? 1200 : 640;
const view = firstView(t, brand.id);
const bg = brand.colors.background;
---
{view && (
  <div class="kthumb" style={`height:${height}px`} aria-hidden="true">
    {t.root === "Canvas" ? (
      <div class="kt-image" style={`background:${bg}`}>
        <img src={view.file} alt="" loading="lazy" />
      </div>
    ) : (
      <div class="thumb view-frame" data-fit={width} style={`height:${height}px;--frame-bg:${bg}`}>
        <div class="scaler">
          <iframe title="" tabindex="-1" srcdoc={previewHtml(view.html)} width={width} height={height} loading="lazy"></iframe>
        </div>
      </div>
    )}
  </div>
)}
<style>
  .kthumb { pointer-events: none; border-bottom: 1px solid var(--line); overflow: hidden; }
  .kt-image { height: 100%; display: grid; place-items: center; }
  .kt-image img { max-width: 100%; max-height: 100%; object-fit: contain; }
</style>
