---
// A template in every brand it's shown in, side by side. Clicking one shows its full preview and its copyable file
// below ([data-brand] elements), here and on the next template page (kept in the browser where it can be).
import KitThumb from "./KitThumb.astro";
import { brandsFor, type TemplateInfo } from "../lib/kits";
interface Props { t: TemplateInfo }
const { t } = Astro.props;
const list = brandsFor(t);
---
<div class="brand-gallery" role="radiogroup" aria-label="Brand" data-brand-switch>
  {list.map((b, i) => (
    <button type="button" role="radio" aria-checked={i === 0 ? "true" : "false"} data-brand-pick={b.id} title={`Show it in ${b.name}`}>
      <KitThumb t={t} brand={b.id} height={t.root === "Canvas" ? 90 : 140} />
      <span class="bg-name">{b.name}</span>
    </button>
  ))}
</div>

<script>
  const KEY = "templates-brand";
  const ids = new Set([...document.querySelectorAll<HTMLElement>("[data-brand-pick]")].map((b) => b.dataset.brandPick!));
  const pick = (id: string, remember: boolean) => {
    if (!ids.has(id)) return;
    document.querySelectorAll<HTMLElement>("[data-brand]").forEach((el) => (el.hidden = el.dataset.brand !== id));
    document.querySelectorAll<HTMLElement>("[data-brand-pick]").forEach((b) => b.setAttribute("aria-checked", String(b.dataset.brandPick === id)));
    if (remember) {
      try {
        localStorage.setItem(KEY, id);
      } catch {}
    }
    // The previews fit themselves to their panels on resize.
    window.dispatchEvent(new Event("resize"));
  };
  document.querySelectorAll<HTMLElement>("[data-brand-switch]").forEach((s) =>
    s.addEventListener("click", (e) => {
      const button = (e.target as HTMLElement).closest<HTMLElement>("[data-brand-pick]");
      if (button) pick(button.dataset.brandPick!, true);
    }),
  );
  let saved: string | null = null;
  try {
    saved = localStorage.getItem(KEY);
  } catch {}
  if (saved) pick(saved, false);
</script>

<style>
  .brand-gallery { display: grid; grid-template-columns: repeat(auto-fit, minmax(104px, 1fr)); gap: 8px; }
  .brand-gallery button { padding: 0; border: 1px solid var(--line); border-radius: var(--radius); background: var(--bg-1); overflow: hidden; cursor: pointer; text-align: left; color: var(--text-2); }
  .brand-gallery button:hover { border-color: var(--line-3); color: var(--text); }
  .brand-gallery button[aria-checked="true"] { border-color: var(--text-2); color: var(--text); box-shadow: 0 0 0 1px var(--text-2); }
  .bg-name { display: block; padding: 8px 10px; font: 13px var(--sans); }
</style>
